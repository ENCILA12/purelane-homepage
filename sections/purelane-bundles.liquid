<!-- PURELANE BUNDLES SECTION -->
<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    
    <!-- Glass Header Panel -->
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
      </div>
    </div>

    <!-- Tiers grid -->
    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle_tier' -%}
          
          {%- assign visible_item_count = 0 -%}
          {%- if block.settings.p_shape_1 != 'none' -%}{%- assign visible_item_count = visible_item_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.p_shape_2 != 'none' -%}{%- assign visible_item_count = visible_item_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.p_shape_3 != 'none' -%}{%- assign visible_item_count = visible_item_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.p_shape_4 != 'none' -%}{%- assign visible_item_count = visible_item_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.p_shape_5 != 'none' -%}{%- assign visible_item_count = visible_item_count | plus: 1 -%}{%- endif -%}

          <article class="glass tier {% if block.settings.is_best %}best{% endif %} rv" {{ block.shopify_attributes }}>
            {%- if block.settings.tag_label != blank -%}
              <span class="tag">{{ block.settings.tag_label }}</span>
            {%- endif -%}
            
            <!-- Tier Pix Bottle Row -->
            <div class="tierpix{% if visible_item_count >= 5 or block.settings.force_five_style %} five{% endif %}" aria-hidden="true">
              {%- if block.settings.p_shape_1 != 'none' -%}
                <span class="pimg {{ block.settings.p_shape_1 }}" role="img" aria-label="Product image 1"></span>
              {%- endif -%}
              {%- if block.settings.p_shape_2 != 'none' -%}
                <span class="pimg {{ block.settings.p_shape_2 }}" role="img" aria-label="Product image 2"></span>
              {%- endif -%}
              {%- if block.settings.p_shape_3 != 'none' -%}
                <span class="pimg {{ block.settings.p_shape_3 }}" role="img" aria-label="Product image 3"></span>
              {%- endif -%}
              {%- if block.settings.p_shape_4 != 'none' -%}
                <span class="pimg {{ block.settings.p_shape_4 }}" role="img" aria-label="Product image 4"></span>
              {%- endif -%}
              {%- if block.settings.p_shape_5 != 'none' -%}
                <span class="pimg {{ block.settings.p_shape_5 }}" role="img" aria-label="Product image 5"></span>
              {%- endif -%}
            </div>

            <!-- Pricing Details -->
            <div class="qty">
              {{ block.settings.qty_number }}
              <small>Products</small>
            </div>
            
            <div class="price">
              ₹{{ block.settings.price }}
              {%- if block.settings.compare_price > block.settings.price -%}
                <s>₹{{ block.settings.compare_price }}</s>
              {%- endif -%}
            </div>
            
            {%- if block.settings.flat_description != blank -%}
              <p class="body-s" style="font-size:12px">{{ block.settings.flat_description }}</p>
            {%- endif -%}

            <!-- Features List -->
            <ul>
              {%- if block.settings.feature_1 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_1 }}
                </li>
              {%- endif -%}
              {%- if block.settings.feature_2 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_2 }}
                </li>
              {%- endif -%}
              {%- if block.settings.feature_3 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_3 }}
                </li>
              {%- endif -%}
              {%- if block.settings.feature_4 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_4 }}
                </li>
              {%- endif -%}
            </ul>

            <!-- Button Action -->
            <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link }}">
              {{ block.settings.button_label }}
              {%- if block.settings.is_best -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          </article>
          
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

