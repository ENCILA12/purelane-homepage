<!-- PURELANE REVIEWS MARQUEE SECTION -->
<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    
    <!-- Scoped Header -->
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg">
        <span class="st">
          {%- for i in (1..section.settings.aggregate_stars) -%}★{%- endfor -%}
        </span>
        <b>{{ section.settings.aggregate_rating }}</b> from {{ section.settings.aggregate_reviews_count }} reviews
      </span>
      <span class="agg">Loved by <b>{{ section.settings.aggregate_homes }}</b> homes</span>
    </div>

  </div>

  <!-- Infinite Scroll Marquee Rail -->
  <div class="revrail rv" aria-label="Customer reviews" style="--marquee-speed: {{ section.settings.marquee_speed }}s;">
    <div class="revtrack" style="animation-duration: var(--marquee-speed);">
      
      <!-- Loop blocks TWICE for seamless infinite carousel effect -->
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'review_item' -%}
            
            <article class="glass-2 rcard" {{ block.shopify_attributes }}>
              <div class="st">
                {%- for star in (1..block.settings.stars) -%}★{%- endfor -%}
              </div>
              <h5>{{ block.settings.title }}</h5>
              <p>{{ block.settings.body_text }}</p>
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
                <b>{{ block.settings.author }}</b>
                {%- if block.settings.product_tag != blank -%}
                  <span>· {{ block.settings.product_tag }}</span>
                {%- endif -%}
              </div>
            </article>

          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}

    </div>
  </div>
</section>

<style>
  /* Local speed overrides for the reviews marquee */
  .revtrack {
    animation-duration: var(--marquee-speed, 52s) !important;
  }
</style>

{% schema %}
{
  "name": "Purelane Reviews Marquee",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Section Kicker Text",
      "default": "That's what they said"
    },
    {
      "type": "range",
      "id": "aggregate_stars",
      "label": "Aggregate Rating Stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "aggregate_reviews_count",
      "label": "Aggregate Reviews Count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "aggregate_homes",
      "label": "Social Proof Homes Text",
      "default": "12 lakh+"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Loop Speed",
      "min": 15,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "review_item",
      "name": "Customer Review Card",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body_text",
          "label": "Review Body Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Reviewed Product/Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Marquee",
      "blocks": [
        {
          "type": "review_item",
          "settings": {
            "title": "Works like a charm",
            "body_text": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_tag": "Laundry detergent"
          }
        },
        {
          "type": "review_item",
          "settings": {
            "title": "Best dishwash ever",
            "body_text": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_tag": "Dishwash gel"
          }
        },
        {
          "type": "review_item",
          "settings": {
            "title": "Great product, packaging",
            "body_text": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_tag": "Liquid handwash"
          }
        },
        {
          "type": "review_item",
          "settings": {
            "title": "Dog friendly",
            "body_text": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_tag": "Floor cleaner"
          }
        },
        {
          "type": "review_item",
          "settings": {
            "title": "Sparkling taps again",
            "body_text": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_tag": "Tap cleaner"
          }
