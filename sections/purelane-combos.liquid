<!-- PURELANE COMBOS SECTION -->
<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    
    <!-- Scoped Header -->
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
      <div class="rule">
        <i></i>
        {%- if section.settings.rule_icon != blank -%}
          {{ section.settings.rule_icon }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        {%- endif -%}
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
    </div>

    <!-- Scrollable Combo Rail -->
    <div class="comborail rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo_item' -%}
          
          <article class="glass combo{% if block.settings.is_highlighted %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {%- if block.settings.save_badge != blank -%}
                <span class="save">{{ block.settings.save_badge }}</span>
              {%- endif -%}
              {%- if block.settings.flag_badge != blank -%}
                <span class="flag">{{ block.settings.flag_badge }}</span>
              {%- endif -%}
              
              <!-- Stack list of 2-3 products -->
              <div class="stack">
                <!-- Item 1 -->
                {%- if block.settings.item_1_shape != 'none' -%}
                  <span class="it">
                    {%- if block.settings.item_1_shape == 'tile' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_1_shape }}" role="img" aria-label="{{ block.settings.item_1_label }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_1_label }}</span>
                  </span>
                {%- endif -%}

                <!-- Plus 1 -->
                {%- if block.settings.item_2_shape != 'none' -%}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {%- if block.settings.item_2_shape == 'tile' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_2_shape }}" role="img" aria-label="{{ block.settings.item_2_label }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_2_label }}</span>
                  </span>
                {%- endif -%}

                <!-- Plus 2 -->
                {%- if block.settings.item_3_shape != 'none' -%}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {%- if block.settings.item_3_shape == 'tile' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_3_shape }}" role="img" aria-label="{{ block.settings.item_3_label }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_3_label }}</span>
                  </span>
                {%- endif -%}
              </div>
            </div>

            <!-- Body Details -->
            <div class="body">
              <h3>{{ block.settings.combo_title }}</h3>
              <div class="cnt">{{ block.settings.combo_count }}</div>
              <p class="inc">{{ block.settings.combo_includes }}</p>
              
              <div class="prow">
                <strong>₹{{ block.settings.price }}</strong>
                {%- if block.settings.compare_price > block.settings.price -%}
                  <s>₹{{ block.settings.compare_price }}</s>
                  {%- if block.settings.custom_saving_text != blank -%}
                    <em>{{ block.settings.custom_saving_text }}</em>
                  {%- endif -%}
                {%- endif -%}
              </div>
              
              <div class="fine">Inclusive of all taxes · COD available</div>
              
              <a class="btn {% if block.settings.is_highlighted %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
          
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    
    <p class="railnote">{{ section.settings.rail_note }}</p>

  </div>
</section>

