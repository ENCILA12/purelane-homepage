<!-- PURELANE HERO SECTION -->
<section class="hero" data-scene="1">
  <div class="hero-grid">

    <!-- DESKTOP PROMISE BADGES -->
    <div class="badges glass-2" aria-label="Product promises">
      {%- for block in section.blocks -%}
        {%- if block.type == 'promise_badge' -%}
          <div class="badge">
            <span class="bi">
              {%- if block.settings.svg_icon != blank -%}
                {{ block.settings.svg_icon }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
              {%- endif -%}
            </span>
            <span>{{ block.settings.badge_label }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- HERO COPY BLOCK -->
    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading }}</h1>
      
      <div class="rule rv rv-d1">
        <i></i>
        {%- if section.settings.rule_icon != blank -%}
          {{ section.settings.rule_icon }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        {%- endif -%}
        <i></i>
      </div>

      <p class="lede rv rv-d2">{{ section.settings.subheading_text }}</p>

      <div class="hero-cta rv rv-d3">
        {%- if section.settings.button_1_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.button_1_link }}">
            {{ section.settings.button_1_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>

      <!-- MOBILE BADGE STRIP -->
      <div class="badgestrip rv rv-d4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'promise_badge' -%}
            <div class="glass-2">
              {%- if block.settings.svg_icon != blank -%}
                {{ block.settings.svg_icon }}
              {%- endif -%}
              {{ block.settings.badge_label | replace: '<br>', ' ' | replace: '<br/>', ' ' }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- HERO PRODUCT STAGE -->
    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {%- assign slide_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_slide' -%}
            {%- assign slide_idx = slide_idx | plus: 1 -%}
            {%- assign item_count_num = block.settings.item_count | plus: 0 -%}
            <div class="hslide hs{{ block.settings.item_count }}{% if slide_idx == 1 %} on{% endif %}" data-n="{{ slide_idx }}" {{ block.shopify_attributes }}>
              
              <!-- Product A -->
              {%- if block.settings.product_1_shape != 'none' -%}
                <span class="hp {{ block.settings.product_1_shape }} a d1" role="img" aria-label="{{ block.settings.product_1_label }}"></span>
              {%- elsif block.settings.product_1_image != blank -%}
                <img src="{{ block.settings.product_1_image | image_url: width: 400 }}" class="hp a d1" alt="{{ block.settings.product_1_label }}" style="height: 80%; width: auto; object-fit: contain;" width="{{ block.settings.product_1_image.width }}" height="{{ block.settings.product_1_image.height }}">
              {%- endif -%}

              <!-- Product B (if count > 1) -->
              {%- if item_count_num > 1 -%}
                {%- if block.settings.product_2_shape != 'none' -%}
                  <span class="hp {{ block.settings.product_2_shape }} b d2" role="img" aria-label="{{ block.settings.product_2_label }}"></span>
                {%- elsif block.settings.product_2_image != blank -%}
                  <img src="{{ block.settings.product_2_image | image_url: width: 400 }}" class="hp b d2" alt="{{ block.settings.product_2_label }}" style="height: 97%; width: auto; object-fit: contain;" width="{{ block.settings.product_2_image.width }}" height="{{ block.settings.product_2_image.height }}">
                {%- endif -%}
              {%- endif -%}

              <!-- Product C (if count > 2) -->
              {%- if item_count_num > 2 -%}
                {%- if block.settings.product_3_shape != 'none' -%}
                  <span class="hp {{ block.settings.product_3_shape }} c d3" role="img" aria-label="{{ block.settings.product_3_label }}"></span>
                {%- elsif block.settings.product_3_image != blank -%}
                  <img src="{{ block.settings.product_3_image | image_url: width: 400 }}" class="hp c d3" alt="{{ block.settings.product_3_label }}" style="height: 79%; width: auto; object-fit: contain;" width="{{ block.settings.product_3_image.width }}" height="{{ block.settings.product_3_image.height }}">
                {%- endif -%}
              {%- endif -%}

              <!-- Price Tag -->
              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.tag_label }}</span>
                <span class="val">
                  <strong>₹{{ block.settings.price }}</strong>
                  {%- if block.settings.compare_price > block.settings.price -%}
                    <s>₹{{ block.settings.compare_price }}</s>
                  {%- endif -%}
                </span>
                {%- if block.settings.savings_text != blank -%}
                  <span class="cut">{{ block.settings.savings_text }}</span>
                {%- endif -%}
              </div>

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Slide Navigation Dots -->
      <div class="hdots" id="hdots">
        {%- assign dot_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_slide' -%}
            {%- assign dot_idx = dot_idx | plus: 1 -%}
            <button type="button" class="{% if dot_idx == 1 %}on{% endif %}" aria-label="Show {{ block.settings.tag_label }}"></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var hstage = document.getElementById('hstage');
    var prod = document.getElementById('heroProd');
    if (hstage && prod) {
      var hs = [].slice.call(hstage.querySelectorAll('.hslide'));
      var hd = [].slice.call(prod.querySelectorAll('#hdots button'));
      var hi = 0, htimer = null;
      
      function hgo(n) {
        hi = (n + hs.length) % hs.length;
        hs.forEach(function (s, i) { s.classList.toggle('on', i === hi); });
        hd.forEach(function (d, i) { d.classList.toggle('on', i === hi); });
      }
      
      function hplay() {
        if (!htimer && !reduce) {
          htimer = setInterval(function () { hgo(hi + 1); }, 3800);
        }
      }
      
      function hstop() {
        if (htimer) {
          clearInterval(htimer);
          htimer = null;
        }
      }
      
      hd.forEach(function (d, i) {
        d.addEventListener('click', function () { hstop(); hgo(i); hplay(); });
      });
      
      hstage.addEventListener('mouseenter', hstop);
      hstage.addEventListener('mouseleave', hplay);
      
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.isIntersecting ? hplay() : hstop(); });
        }, { threshold: 0.2 }).observe(hstage);
      } else {
        hplay();
      }

      /* ambient drift on the hero product container */
      if (!reduce) {
        prod.animate(
          [{ filter: 'drop-shadow(0 34px 54px rgba(2,20,19,.6))' },
           { filter: 'drop-shadow(0 42px 68px rgba(2,20,19,.68))' },
           { filter: 'drop-shadow(0 34px 54px rgba(2,20,19,.6))' }],
          { duration: 7000, iterations: Infinity, easing: 'ease-in-out' }
        );
      }
    }
  })();
</script>

